# LLM Configuration
# Provider: openai, anthropic, or openai-compatible (Ollama, vLLM, etc.)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
# For local models (Ollama etc): LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL=

# Image Generation (optional — AI scene/NPC images)
# Falls back to LLM_API_KEY if IMAGE_API_KEY is not set.
# Set IMAGE_PROVIDER=none to disable.
# IMAGE_PROVIDER=openai
# IMAGE_API_KEY=
# IMAGE_MODEL=dall-e-3
# IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=standard

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database (optional — defaults to backend/data/dnd_game.db)
# DATABASE_URL=sqlite:///backend/data/dnd_game.db
