# LLM Configuration
# Provider: openai, anthropic, or openai-compatible (Ollama, vLLM, etc.)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
# For local models (Ollama etc): LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL=

# Database
DATABASE_URL=sqlite:///./data/dnd_game.db
